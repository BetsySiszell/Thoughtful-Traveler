library(tidyverse)
misool <- tibble(
category = c("Energy", "Water", "Food", "Local Impact", "Conservation", "Transparency"),
score = c(9, 9, 9, 10, 10, 9)
)
ggplot(misool, aes(x = reorder(category, score), y = score)) +
geom_col() +
coord_flip() +
labs(
title = "Sustainability Scorecard",
x = "",
y = "Score (out of 10)"
)
